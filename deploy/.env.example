# Variables for the Dockhand stack. Enter these in Dockhand, or copy this file
# to deploy/.env for a local run. Never commit the filled-in version.

# Required. The password for the host area at /admin.
ADMIN_PASSWORD=change-me

# Required. Any long random string; only the containers use it.
POSTGRES_PASSWORD=change-me-too

# Required. Signs guest sign-in cookies; 32+ random characters (openssl rand -hex 32).
# Changing it signs every guest out.
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters

# Required. The address guests type or scan, e.g. http://192.168.1.20:3099 or
# https://party.example.com. Emailed sign-in and invite links point here.
PUBLIC_URL=http://unraid.local:3099

# Optional: outgoing email for RSVP sign-in links and invites. Any SMTP server
# works (Gmail/Fastmail app password, Postmark, SES, Resend's SMTP). Leave
# SMTP_HOST empty to go without email; invite links can still be copied from
# the Guests tab. SMTP_SECURE=true for port 465, false for STARTTLS on 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Party <party@example.com>

# Optional overrides.
POSTGRES_DB=contest
POSTGRES_USER=contest
# Where Postgres data and uploaded photos live on the server.
APPDATA_PATH=/mnt/user/appdata/contest-now
# Port guests connect to.
WEB_PORT=3099
# GitHub owner the images were published under.
GITHUB_OWNER=drakebridgewater
# Pin to a specific build with sha-<short> instead of latest.
IMAGE_TAG=latest
LOG_LEVEL=info

# Contest App Environment Configuration
# Copy this file to .env and adjust values for your environment

# ===========================================
# PRODUCTION CONFIGURATION
# ===========================================

# Base URL - Full URL where your app is hosted
# Local:      BASE_URL=http://localhost:3099
# Production: BASE_URL=https://your-domain.com
BASE_URL=http://localhost:3099

# ===========================================
# ADMIN/SECURITY
# ===========================================

# Admin password for accessing results and management pages
# IMPORTANT: Change this in production!
REACT_APP_ADMIN_PASSWORD=pdxmas2025

# ===========================================
# BACKEND CONFIGURATION
# ===========================================

# Node environment (development or production)
NODE_ENV=production

# Backend port (internal Docker port)
PORT=3001

# Database path (inside container)
DATABASE_PATH=/app/data/contest.db

# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================

# Uncomment and set if you need custom ports
# BACKEND_PORT=3001
# FRONTEND_PORT=3099

# ===========================================
# NOTES
# ===========================================
# - Never commit the .env file to git (it's in .gitignore)
# - Use this .env.example as a template
# - For production, create a .env file with your production URL and password
# - The BASE_URL is used by the backend to generate image URLs
# - The REACT_APP_ADMIN_PASSWORD is embedded in the frontend at build time
# - REACT_APP_ prefix is required for React environment variables

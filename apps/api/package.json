{
  "name": "@contest/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Contest API: Express 5 + Drizzle (Postgres) + Zod.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "npx --yes drizzle-kit@0.31.10 generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@contest/shared": "*",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.7",
    "sharp": "^0.35.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}

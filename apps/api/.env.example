# Local development settings for the API (copy to .env; never commit .env)
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgres://contest:contest@localhost:5432/contest
# Password for the results/admin area. Required.
ADMIN_PASSWORD=dev-admin
# Public URL the API is reachable at, used to build photo URLs.
BASE_URL=http://localhost:3001
# Where uploaded photos are stored.
UPLOADS_DIR=./uploads
# Allowed browser origin for CORS (the Vite dev server). Use * only on a private LAN.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Signs guest sign-in cookies. Optional in development (a fixed dev secret is used).
# BETTER_AUTH_SECRET=
# Where guests open the app (the Vite dev server); sign-in links point here.
PUBLIC_URL=http://localhost:5173
# Outgoing email. Leave SMTP_HOST empty and sign-in links are printed in this log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
